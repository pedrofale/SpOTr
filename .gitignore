
# ---- added 2026-08-26: keep code and findings, exclude data and intermediates ----
# Raw downloads and prepared inputs are large (experiments/ is ~15GB) and reproducible
# from the scripts that build them.
*.npz
*.mtx
*.tar.gz
*.zip
*.h5ad
*.rds
*.RDS
experiments/**/export/
experiments/**/raw/
experiments/**/cache/
experiments/etracer/Tumor_Immune_Evasion_eTRACER/
experiments/gbm_screen/b178/
experiments/**/link_entries.txt
experiments/**/link_cols.txt

# run logs: tqdm progress bars make these large and they carry no information the
# NOTES and result CSVs do not
*.log

__pycache__/
*.pyc
.pybiomart.sqlite

# notebooks with embedded outputs run to tens of MB; the analysis lives in experiments/
notebooks/*_numbat_results.ipynb
notebooks/*_data.ipynb
notebooks/*_benchmark_real.ipynb
notebooks/*_benchmark_cache/
experiments/**/ext/
*.h5
*.gz
notebooks/toy_example.ipynb

# ---- added 2026-09-07 when committing the night runs and the new modules ----
# Downloaded public datasets. 2.0 GB, reproducible from their accessions
# (KP-Spatial: Zenodo 19771805). Never in the repo.
data/

# Solver intermediates. 153 files, none previously tracked; regenerated by the
# scripts beside them.
*.pkl

# Large intermediates from the night runs (relationship.npy alone is 64 MB).
# Scoped to night/ deliberately: .npy IS tracked under experiments/bcsa3/ and
# experiments/etracer/, and a blanket rule would contradict the index.
experiments/night/*.npy
